NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=app

# PostgreSQL (optional — use getPgPool() when needed)
POSTGRES_URI=postgresql://user:password@localhost:5432/app

# Redis (optional — plugin no-ops when unset; set URI to enable)
REDIS_URI=redis://localhost:6379

# JWT (required, min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRES_IN=7d

# CORS: * allows all in non-production; in production set explicit origins (comma-separated)
CORS_ORIGIN=*

# Object storage (optional scaffolds under src/infrastructure/storage)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
LOCAL_STORAGE_PATH=./uploads

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Optional: override default log level (debug in development, info in production)
# LOG_LEVEL=info
